# Copier en .env et remplir. Ne JAMAIS commiter .env.
# En dev, Django lit ce fichier (config/settings/dev.py). En prod, seules les
# variables d'environnement réelles comptent : aucun fichier n'est lu.

# --- Django -------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
# Générer : python -c "import secrets;print(secrets.token_urlsafe(50))"
# prod refuse une clé de moins de 50 caractères ou commençant par « change-me ».
DJANGO_SECRET_KEY=change-me-generate-with-python-secrets-token_urlsafe-50
# Liste séparée par des virgules ; « * » est refusé en prod.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Prod uniquement : origines HTTPS autorisées pour le CSRF (ex. https://these.example.org).
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- PostgreSQL (docker compose) ----------------------------------------------
POSTGRES_DB=theses
POSTGRES_USER=theses
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://theses:change-me@127.0.0.1:5432/theses

# --- Redis / Celery -----------------------------------------------------------
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@127.0.0.1:6379/0

# --- Courriel -----------------------------------------------------------------
# Dev : sortie console (fixé dans dev.py). Prod : URL SMTP,
# ex. smtp+tls://utilisateur:motdepasse@smtp.example.org:587
EMAIL_URL=
DEFAULT_FROM_EMAIL=noreply@localhost

# --- Coffre (M2, pas encore utilisé) -------------------------------------------
# Clé maîtresse de développement pour dériver les KEK (32 octets en base64).
# Générer : python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# En production : remplacée par Vault/OpenBao ou un HSM.
MASTER_KEY=
# Stockage des blobs chiffrés
VAULT_STORAGE_DIR=./var/vault
