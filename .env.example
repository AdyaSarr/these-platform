# Copier en .env et remplir. Ne JAMAIS commiter .env.
# En dev, Django lit ce fichier (config/settings/dev.py). En prod, seules les
# variables d'environnement réelles comptent : aucun fichier n'est lu.

# --- Django -------------------------------------------------------------------
# Production : config.settings.prod. dev et test refusent de démarrer si
# DJANGO_ALLOWED_HOSTS contient un hôte non local.
DJANGO_SETTINGS_MODULE=config.settings.dev
# Générer : python -c "import secrets;print(secrets.token_urlsafe(50))"
# prod refuse une clé de moins de 50 caractères ou commençant par « change-me ».
DJANGO_SECRET_KEY=change-me-generate-with-python-secrets-token_urlsafe-50
# Liste séparée par des virgules ; « * » est refusé en prod.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Prod uniquement : origines HTTPS autorisées pour le CSRF (ex. https://these.example.org).
DJANGO_CSRF_TRUSTED_ORIGINS=
# URL publique de la plateforme, pour les liens des courriels (envoyés hors requête).
# Prod : obligatoire et en https:// (ex. https://these.example.org).
DJANGO_SITE_URL=http://localhost:8000

# --- PostgreSQL (docker compose) ----------------------------------------------
POSTGRES_DB=theses
POSTGRES_USER=theses
POSTGRES_PASSWORD=change-me
# Obligatoire partout, PostgreSQL seulement (postgres://).
DATABASE_URL=postgres://theses:change-me@127.0.0.1:5432/theses

# --- Redis / Celery -----------------------------------------------------------
REDIS_PASSWORD=change-me
# Obligatoire partout (redis:// ou rediss://).
REDIS_URL=redis://:change-me@127.0.0.1:6379/0

# --- Courriel -----------------------------------------------------------------
# Dev : sortie console (fixé dans dev.py). Prod : obligatoire, SMTP seulement
# (smtp://, smtp+tls://, smtp+ssl://), ex. smtp+tls://utilisateur:motdepasse@smtp.example.org:587
EMAIL_URL=
# Prod : obligatoire, une adresse du domaine de la plateforme (jamais @localhost).
DEFAULT_FROM_EMAIL=noreply@localhost

# --- Coffre ---------------------------------------------------------------------
# Clé maîtresse (32 octets en base64). Obligatoire : dès M1, la clé des pseudonymes
# du journal d'audit (ip_hash, courriel d'une connexion échouée) en est dérivée
# par HKDF ; en M2, les KEK aussi. La changer rend les anciens pseudonymes
# incomparables aux nouveaux.
# Générer : python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# En production : remplacée par Vault/OpenBao ou un HSM.
MASTER_KEY=
# Stockage des blobs chiffrés
VAULT_STORAGE_DIR=./var/vault
