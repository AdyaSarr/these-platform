{
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run bandit:*)",
      "Bash(uv run pip-audit:*)",
      "Bash(uv run python manage.py check:*)",
      "Bash(uv run python manage.py makemigrations:*)",
      "Bash(uv run python manage.py migrate:*)",
      "Bash(uv sync:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.dev)",
      "Read(./.env.prod)",
      "Read(./.env.production)",
      "Read(./secrets/**)",
      "Read(./var/vault/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(cat .env:*)",
      "Bash(git push:*)",
      "Bash(rm -rf:*)"
    ]
  }
}
