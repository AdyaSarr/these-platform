#: templates/accounts/email/password_reset_body.txt:1
msgid "Hello,"
msgstr "Bonjour,"

#: templates/accounts/email/invitation_body.txt:3
msgid ""
"You are invited to join a thesis follow-up platform. To accept, open this "
"link (valid for 72 hours, single use):"
msgstr ""
"Vous êtes invité·e à rejoindre une plateforme de suivi de thèse. Pour "
"accepter, ouvrez ce lien (valable 72 heures, à usage unique) :"

#: templates/accounts/email/invitation_body.txt:7
msgid "If you were not expecting this invitation, ignore this message."
msgstr "Si vous n'attendiez pas cette invitation, ignorez ce message."

#: templates/accounts/email/invitation_subject.txt:1
msgid "Invitation to the thesis platform"
msgstr "Invitation à la plateforme de suivi de thèse"

#: templates/accounts/email/password_reset_body.txt:3
msgid ""
"A password reset was requested for your account. To choose a new password, "
"open this link (single use):"
msgstr ""
"Une réinitialisation du mot de passe a été demandée pour votre compte. Pour "
"choisir un nouveau mot de passe, ouvrez ce lien (à usage unique) :"

#: templates/accounts/email/password_reset_body.txt:7
msgid ""
"If you did not request it, ignore this message: your password stays "
"unchanged."
msgstr ""
"Si vous n'en êtes pas à l'origine, ignorez ce message : votre mot de passe "
"reste inchangé."

#: templates/accounts/email/password_reset_subject.txt:1
msgid "Password reset on the thesis platform"
msgstr "Réinitialisation du mot de passe sur la plateforme de suivi de thèse"

